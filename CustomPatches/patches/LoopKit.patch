     public init(id: UUID = UUID(),
                 date: Date = Date(),
@@ -344,7 +348,10 @@ public struct StoredDosingDecision: DosingDecision {
                 enactedBolusAmount: Double? = nil,
                 warnings: [Issue] = [],
                 errors: [Issue] = [],
-                syncIdentifier: UUID = UUID()) {
+                syncIdentifier: UUID = UUID(),
+                //wp begin
+                automaticDosingStrategy: AutomaticDosingStrategy = .tempBasalOnly) {
+                //wp end
         self.id = id
         self.date = date
         self.controllerTimeZone = controllerTimeZone
@@ -372,6 +379,9 @@ public struct StoredDosingDecision: DosingDecision {
         self.warnings = warnings
         self.errors = errors
         self.syncIdentifier = syncIdentifier
+        //wp begin
+        self.automaticDosingStrategy = automaticDosingStrategy
+        //wp end
     }
 
     public struct Settings: Codable, Equatable {
@@ -471,7 +481,11 @@ extension StoredDosingDecision: Codable {
                   enactedBolusAmount: try container.decodeIfPresent(Double.self, forKey: .enactedBolusAmount),
                   warnings: try container.decodeIfPresent([Issue].self, forKey: .warnings) ?? [],
                   errors: try container.decodeIfPresent([Issue].self, forKey: .errors) ?? [],
-                  syncIdentifier: try container.decode(UUID.self, forKey: .syncIdentifier))
+                  syncIdentifier: try container.decode(UUID.self, forKey: .syncIdentifier),
+                  //wp begin
+                  // 用 decodeIfPresent 兜底，保证能读取本字段出现之前持久化的历史记录
+                  automaticDosingStrategy: try container.decodeIfPresent(AutomaticDosingStrategy.self, forKey: .automaticDosingStrategy) ?? .tempBasalOnly)
+                  //wp end
     }
 
     public func encode(to encoder: Encoder) throws {
@@ -503,6 +517,9 @@ extension StoredDosingDecision: Codable {
         try container.encodeIfPresent(!warnings.isEmpty ? warnings : nil, forKey: .warnings)
         try container.encodeIfPresent(!errors.isEmpty ? errors : nil, forKey: .errors)
         try container.encode(syncIdentifier, forKey: .syncIdentifier)
+        //wp begin
+        try container.encode(automaticDosingStrategy, forKey: .automaticDosingStrategy)
+        //wp end
     }
 
     private enum CodingKeys: String, CodingKey {
@@ -533,6 +550,9 @@ extension StoredDosingDecision: Codable {
         case warnings
         case errors
         case syncIdentifier
+        //wp begin
+        case automaticDosingStrategy
+        //wp end
     }
 }
 
