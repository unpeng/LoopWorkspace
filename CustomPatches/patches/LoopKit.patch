diff --git a/LoopKit/AutomaticDosingStrategy.swift b/LoopKit/AutomaticDosingStrategy.swift
index 559af029..ebcedb39 100644
--- a/LoopKit/AutomaticDosingStrategy.swift
+++ b/LoopKit/AutomaticDosingStrategy.swift
@@ -15,3 +15,29 @@ public enum AutomaticDosingStrategy: Int, CaseIterable, Codable {
     case automaticBolus = 1
     case tempBasalOnly = 0
 }
+
+//wp begin
+// 远程指令与 Nightscout 上传都需要给这个枚举一个字符串表示。
+// 枚举本身是 Int 承载的，所以在这里集中定义一次映射，
+// 避免在远程通知解析、动作描述、loopStatus 上传三处各写一遍字面量。
+extension AutomaticDosingStrategy {
+
+    /// 远程指令与 Nightscout loopStatus 中使用的字符串表示
+    public var remoteCommandValue: String {
+        switch self {
+        case .automaticBolus:
+            return "automaticBolus"
+        case .tempBasalOnly:
+            return "tempBasalOnly"
+        }
+    }
+
+    /// 从远程指令的字符串表示还原；无法识别时返回 nil，由调用方决定如何处理
+    public init?(remoteCommandValue: String) {
+        guard let match = Self.allCases.first(where: { $0.remoteCommandValue == remoteCommandValue }) else {
+            return nil
+        }
+        self = match
+    }
+}
+//wp end
