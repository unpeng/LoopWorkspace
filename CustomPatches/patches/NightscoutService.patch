             return try OverrideRemoteNotification(dictionary: self)
         } else if OverrideCancelRemoteNotification.includedInNotification(self) {
             return try OverrideCancelRemoteNotification(dictionary: self)
+        //wp begin
+        // 放在链尾：它只靠 notes 的取值识别，是所有类型里条件最宽松的一个。
+        // 若提前判断，任何 notes 恰好是 "automaticBolus"/"tempBasalOnly" 的
+        // 大剂量、碳水或 override 通知都会被误判成切换给药策略。
+        } else if AutomaticDosingStrategyRemoteNotification.includedInNotification(self) {
+            return try AutomaticDosingStrategyRemoteNotification(dictionary: self)
+        //wp end
         } else {
             throw RemoteNotificationError.unhandledNotification(self)
         }
