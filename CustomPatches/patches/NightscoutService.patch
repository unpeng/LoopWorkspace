diff --git a/NightscoutServiceKit/RemoteCommands/V1/Notifications/AutomaticDosingStrategyRemoteNotification.swift b/NightscoutServiceKit/RemoteCommands/V1/Notifications/AutomaticDosingStrategyRemoteNotification.swift
new file mode 100644
