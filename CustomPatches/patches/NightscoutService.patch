@@ -18,6 +18,9 @@ public struct BolusRemoteNotification: RemoteNotification, Codable {
     public let otp: String?
     public let enteredBy: String?
     public let encryptedReturnNotification: String?
+    //wp begin
+    public let notes: String?
+    //wp end
     
     enum CodingKeys: String, CodingKey {
         case remoteAddress = "remote-address"
@@ -27,12 +30,42 @@ public struct BolusRemoteNotification: RemoteNotification, Codable {
         case otp = "otp"
         case enteredBy = "entered-by"
         case encryptedReturnNotification = "encrypted_return_notification"
+        //wp begin
+        case notes = "notes"
+        //wp end
     }
     
+    //wp begin
     func toRemoteAction() -> Action {
-        return .bolusEntry(BolusAction(amountInUnits: amount))
+        
+        guard let notes = notes,
+              let (carbsValue, absorptionHours) = parseNotes(notes),
+              carbsValue > 0
+        else {
+            return .bolusEntry(BolusAction(amountInUnits: amount))
+        }
+        
+        let absorptionTime = TimeInterval(hours: absorptionHours)
+        
+        return .bolusEntry(BolusAction(
+            amountInUnits: amount,
+            amountInGrams: carbsValue,
+            absorptionTime: absorptionTime
+        ))
     }
     
+    private func parseNotes(_ notes: String) -> (Double, Double)? {
+        let components = notes.split(separator: "|")
+        guard components.count == 2,
+              let carbsValue = Double(components[0]),
+              let absorptionHours = Double(components[1])
+        else {
+            return nil
+        }
+        return (carbsValue, absorptionHours)
+    }
+    //wp end
+    
     func otpValidationRequired() -> Bool {
         return true
     }
