     enum CodingKeys: String, CodingKey {
         case remoteAddress = "remote-address"
@@ -27,11 +31,42 @@ public struct BolusRemoteNotification: RemoteNotification, Codable {
         case otp = "otp"
         case enteredBy = "entered-by"
         case encryptedReturnNotification = "encrypted_return_notification"
+        //wp begin
+        case notes = "notes"
+        //wp end
     }
     
     func toRemoteAction() -> Action {
-        return .bolusEntry(BolusAction(amountInUnits: amount))
+        //wp begin
+        // notes 里带了碳水就走"碳水 + 大剂量"的合并指令，否则退回普通大剂量
+        guard let carbs = parseCarbsFromNotes() else {
+            return .bolusEntry(BolusAction(amountInUnits: amount))
+        }
+
+        return .bolusEntry(BolusAction(amountInUnits: amount,
+                                       amountInGrams: carbs.amountInGrams,
+                                       absorptionTime: carbs.absorptionTime))
+        //wp end
+    }
+
+    //wp begin
+    /// 解析 notes 里的碳水信息，格式为 `克数|吸收小时数`，例如 `45|3`。
+    /// 格式不符、克数非正数时返回 nil，此时按普通大剂量处理。
+    private func parseCarbsFromNotes() -> (amountInGrams: Double, absorptionTime: TimeInterval)? {
+        guard let notes else { return nil }
+
+        let components = notes.split(separator: "|")
+        guard components.count == 2,
+              let amountInGrams = Double(components[0]),
+              let absorptionHours = Double(components[1]),
+              amountInGrams > 0
+        else {
+            return nil
+        }
+
+        return (amountInGrams, TimeInterval(hours: absorptionHours))
     }
+    //wp end
     
     func otpValidationRequired() -> Bool {
         return true
diff --git a/NightscoutServiceKit/RemoteCommands/V1/Notifications/RemoteNotification.swift b/NightscoutServiceKit/RemoteCommands/V1/Notifications/RemoteNotification.swift
