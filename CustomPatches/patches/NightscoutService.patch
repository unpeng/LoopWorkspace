@@ -10,14 +10,37 @@ struct RemoteCommandValidator {
     
     let otpManager: OTPManager
     let nowDateSource: () -> Date = {Date()}
+
+    //wp begin
+    /// 跳过一次性密码校验的发送者集合（匹配远程通知的 entered-by 字段）。
+    ///
+    /// 默认为空 = 不豁免任何人；源码里不再硬编码任何发送者。该值来自
+    /// NightscoutService 的本机持久化配置（rawState），由用户在本机的服务设置里
+    /// 手动填写，不会编进分发的二进制。
+    ///
+    /// ⚠️ 安全提示：entered-by 完全由发送方控制、不可信。任何能向本机 APNs 令牌
+    /// 投递通知的一方都能填上这里的值，从而在无 OTP 的情况下触发打大剂量、录碳水、
+    /// 切换给药策略等操作。仅在你能确保 APNs 投递路径可信、且填了足够私密、
+    /// 难以猜测的值时才启用它。
+    let otpExemptSenders: Set<String>
+    //wp end
     
-    internal init(otpManager: OTPManager) {
+    internal init(otpManager: OTPManager, otpExemptSenders: Set<String> = []) {
         self.otpManager = otpManager
+        self.otpExemptSenders = otpExemptSenders
     }
     
     func validate(remoteNotification: RemoteNotification) throws {
         try validateExpirationDate(remoteNotification: remoteNotification)
         if remoteNotification.otpValidationRequired() {
+            //wp begin
+            // 仅当本机显式配置了豁免发送者、且通知的 entered-by 命中时才跳过 OTP。
+            if !otpExemptSenders.isEmpty,
+               let sender = remoteNotification.enteredBy,
+               otpExemptSenders.contains(sender) {
+                return
+            }
+            //wp end
             try validateOTP(remoteNotification: remoteNotification)
         }
     }
