diff --git a/NightscoutServiceKit/RemoteCommands/V1/Notifications/AutomaticDosingStrategyRemoteNotification.swift b/NightscoutServiceKit/RemoteCommands/V1/Notifications/AutomaticDosingStrategyRemoteNotification.swift
new file mode 100644
index 0000000..c4c83d5
--- /dev/null
+++ b/NightscoutServiceKit/RemoteCommands/V1/Notifications/AutomaticDosingStrategyRemoteNotification.swift
@@ -0,0 +1,59 @@
+//
+//  AutomaticDosingStrategyRemoteNotification.swift
+//  NightscoutServiceKit
+//
+//  远程切换自动给药策略。
+//
+//  这类通知没有专属的载荷字段，靠 notes 恰好等于某个策略的字符串表示来识别，
+//  例如 notes = "automaticBolus" 或 "tempBasalOnly"。
+//  因为识别条件比其他通知都宽松，所以在 toRemoteNotification() 的分发链里
+//  必须排在最后，避免把带有同样 notes 的大剂量／碳水／override 通知误判过来。
+//
+
+import Foundation
+import LoopKit
+
+public struct AutomaticDosingStrategyRemoteNotification: RemoteNotification, Codable {
+
+    public let notes: String?
+    public let remoteAddress: String
+    public let expiration: Date?
+    public let sentAt: Date?
+    public let otp: String?
+    public let enteredBy: String?
+    public let encryptedReturnNotification: String?
+
+    enum CodingKeys: String, CodingKey {
+        case remoteAddress = "remote-address"
+        case notes = "notes"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case otp = "otp"
+        case enteredBy = "entered-by"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+
+    /// 从 notes 解析目标策略。includedInNotification 已经保证过 notes 可识别，
+    /// 这里的兜底只是为了不写强解包。
+    var automaticDosingStrategy: AutomaticDosingStrategy {
+        guard let notes, let strategy = AutomaticDosingStrategy(remoteCommandValue: notes) else {
+            return .tempBasalOnly
+        }
+        return strategy
+    }
+
+    func toRemoteAction() -> Action {
+        return .automaticDosingStrategy(AutomaticDosingStrategyAction(automaticDosingStrategy: automaticDosingStrategy))
+    }
+
+    func otpValidationRequired() -> Bool {
+        return true
+    }
+
+    public static func includedInNotification(_ notification: [String: Any]) -> Bool {
+        guard let notes = notification["notes"] as? String else {
+            return false
+        }
+        return AutomaticDosingStrategy(remoteCommandValue: notes) != nil
+    }
+}
