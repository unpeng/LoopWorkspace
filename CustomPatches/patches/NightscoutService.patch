@@ -0,0 +1,51 @@
+//
+//  AutomaticDosingStrategyRemoteNotification.swift
+//  NightscoutService
+//
+//  Created by Peng on 2026/7/24.
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+//wp begin
+import Foundation
+import LoopKit
+
+public struct AutomaticDosingStrategyRemoteNotification: RemoteNotification, Codable {
+    
+    public let encryptedReturnNotification: String?
+    public let notes: String?
+    public let remoteAddress: String
+    public let expiration: Date?
+    public let sentAt: Date?
+    public let otp: String?
+    public let enteredBy: String?
+    
+    enum CodingKeys: String, CodingKey {
+        case remoteAddress = "remote-address"
+        case notes = "notes"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case otp = "otp"
+        case enteredBy = "entered-by"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+    
+    func toRemoteAction() -> Action {
+        var automaticDosingStrategy = AutomaticDosingStrategy.tempBasalOnly
+        if let notesValue = notes, notesValue == "automaticBolus" {
+            automaticDosingStrategy = AutomaticDosingStrategy.automaticBolus
+        }
+        let action = AutomaticDosingStrategyAction(automaticDosingStrategy: automaticDosingStrategy)
+        return .automaticDosingStrategy(action)
+    }
+    
+    func otpValidationRequired() -> Bool {
+        return true
+    }
+    
+    public static func includedInNotification(_ notification: [String: Any]) -> Bool {
+        guard let note = notification["notes"] as? String else { return false }
+        return note == "tempBasalOnly" || note == "automaticBolus"
+    }
+}
+//wp end
diff --git a/NightscoutServiceKit/RemoteCommands/V1/Notifications/BolusRemoteNotification.swift b/NightscoutServiceKit/RemoteCommands/V1/Notifications/BolusRemoteNotification.swift
